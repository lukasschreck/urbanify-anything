# Kopieren nach .env (im Wurzelverzeichnis des Repos) und anpassen. Die Datei
# wird beim Start gelesen; was schon in der Umgebung steht, hat Vorrang.
# Nichts hiervon ist nötig, um anzufangen — die Vorgaben sind öffentliche
# Instanzen, die für gelegentliche Erhebungen gedacht sind.

# Du fragst in eigenem Namen ab und bist dafür selbst verantwortlich (README,
# „Verantwortung“). Wer sich hier ausweist, wird von Betreibern angeschrieben
# statt gesperrt; Nominatim verlangt die Angabe. Eine Mailadresse oder URL.
URBANIFY_CONTACT=

# Eigene Instanzen. Wer regelmäßig oder für viele Städte erhebt, stellt die
# hin, statt die öffentlichen zu belasten.
# URBANIFY_VALHALLA=http://localhost:8002
# URBANIFY_NOMINATIM=http://localhost:8080
# URBANIFY_OVERPASS=http://localhost:12345/api/interpreter

# Eigene Quellenliste, wenn sie nicht in src/urbanify/catalog.yaml liegt.
# URBANIFY_CATALOG=~/katalog.yaml

# Abrufe in nicht öffentliche Netze sind gesperrt. Nur einschalten, wenn ein
# Katalog-Endpunkt im eigenen Netz liegt.
# URBANIFY_ALLOW_PRIVATE=1

# URBANIFY_DATA=./data
# URBANIFY_DAYS=60
# URBANIFY_DELAY=1.0
# URBANIFY_CONCURRENCY=24
